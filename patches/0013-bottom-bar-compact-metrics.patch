+/**
+ * The three widths that size the capsule: an item's maximum width, the gap between items and the
+ * padding the capsule keeps at each end (see [FloatingCapsuleRow]).
+ *
+ * [Native] is the ColorOS 17 default (`coui_bottom_floating_navigation_bar_item_max_width` 70dp,
+ * `_item_space` 8dp, `_item_padding` 12dp). [Compact] is the tighter capsule native apps end up
+ * with when the bar is squeezed — Clock's items measure 62dp — with the gaps scaled down alongside
+ * so the proportions hold: 62dp items, 4dp apart, 10dp at each end.
+ */
+@Immutable
+data class BottomFloatingNavigationBarMetrics(
+    val itemMaxWidth: Dp,
+    val itemSpacing: Dp,
+    val innerPadding: Dp,
+) {
+    companion object {
+        val Native = BottomFloatingNavigationBarMetrics(
+            itemMaxWidth = BottomFloatingNavigationBarDefaults.ItemMaxWidth,
+            itemSpacing = BottomFloatingNavigationBarDefaults.ItemSpacing,
+            innerPadding = BottomFloatingNavigationBarDefaults.ItemInnerPadding,
+        )
+        val Compact = BottomFloatingNavigationBarMetrics(itemMaxWidth = 62.dp, itemSpacing = 4.dp, innerPadding = 10.dp)
+    }
+}
+
+/** The capsule widths for the bars below; [BottomFloatingNavigationBarMetrics.Native] by default. */
+val LocalBottomFloatingNavigationBarMetrics = staticCompositionLocalOf { BottomFloatingNavigationBarMetrics.Native }
